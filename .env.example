# Copy this file to .env.local and fill in the values. Testnet only.

# Trustless Work API key (testnet / dev.api.trustlesswork.com) — from https://dapp.trustlesswork.com
NEXT_PUBLIC_API_KEY=

# Ghost-Proof platform wallet (dispute resolver + platform address).
# Generate one with: node scripts/create-platform-wallet.mjs
PLATFORM_SECRET_KEY=

# Passcode for the resolver dispute desk at /resolver
RESOLVER_PASSCODE=change-me
